!models/04_acoustic_classifier/project/outputs/**/*.pth
!models/04_acoustic_classifier/project/outputs/**/*.json
!models/04_acoustic_classifier/project/outputs/**/*.png
!models/04_acoustic_classifier/project/outputs/**/*.jpg

# Training outputs (general exclusion)
