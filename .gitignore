# Audio dataset files (exclude raw audio)
models/04_acoustic_classifier/project/data/**/*.wav
models/04_acoustic_classifier/project/data/**/*.mp3
models/04_acoustic_classifier/project/data/**/*.flac

# Model artifacts (general exclusion)
models/**/*.pkl
models/**/*.h5
models/**/*.joblib
models/**/*.onnx
models/**/*.pb
models/**/*.weights
models/**/saved_model/

# Exception: Keep acoustic classifier trained models and results
!models/04_acoustic_classifier/project/outputs/
